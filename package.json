{
  "name": "pi-self-update",
  "version": "0.1.1",
  "description": "Let pi modify itself in-session: write files → validate → hot reload / cold restart → verify → explicit rollback. Tools: pi_self_status / pi_self_reload / pi_self_apply / pi_self_rollback / pi_self_restart.",
  "keywords": [
    "pi-package",
    "pi",
    "self-update",
    "hot-reload",
    "restart",
    "agent-tooling"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-1220/pi-self-update.git"
  },
  "homepage": "https://github.com/Z-1220/pi-self-update#readme",
  "bugs": {
    "url": "https://github.com/Z-1220/pi-self-update/issues"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "extensions",
    "bin",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
